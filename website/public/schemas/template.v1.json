{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://game.nsgo.dev/schemas/template.v1.json",
  "title": "NSGo project template manifest (version 1)",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "genre": {
      "type": "string"
    },
    "dimension": {
      "type": "string"
    },
    "orientation": {
      "type": "string"
    },
    "players": {
      "$ref": "#/definitions/Players"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cover": {
      "type": "string"
    },
    "playtest": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Players": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": -9223372036854776000,
          "maximum": 9223372036854776000
        },
        "max": {
          "type": "integer",
          "minimum": -9223372036854776000,
          "maximum": 9223372036854776000
        },
        "local": {
          "type": "boolean"
        },
        "online": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
