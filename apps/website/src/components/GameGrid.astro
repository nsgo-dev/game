---
// The grid GameCards sit in: one column on a phone, two on wider screens.
interface Props {
	label?: string;
}
const { label } = Astro.props;
---

<ol class="games" aria-label={label}>
	<slot />
</ol>

<style>
	.games {
		display: grid;
		gap: 1px;
		margin: 0;
		padding: 0;
		border: 1px solid var(--border);
		background-color: var(--border);
		list-style: none;
	}
	@media (min-width: 40rem) {
		.games {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		/* An odd last game takes the whole row rather than leave a hole. */
		.games > :global(:last-child:nth-child(odd)) {
			grid-column: 1 / -1;
		}
	}
</style>
