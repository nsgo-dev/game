---
// A game in a grid of cells, in the demoscene look: its number and kind, its title linking to where it is played, its description, its tags and targets, and its links. The home page, the showcase and the playground list games with it, inside a GameGrid.
interface Link {
	label: string;
	href: string;
	external?: boolean;
}
interface Props {
	label: string;
	kind?: string;
	title: string;
	href: string;
	external?: boolean;
	description: string;
	tags?: string[];
	targets?: string[];
	meta?: string;
	links?: Link[];
	/** The title's heading level. */
	level?: 2 | 3;
}
const { label, kind, title, href, external, description, tags = [], targets = [], meta, links = [], level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
const out = (e?: boolean) => (e ? { target: '_blank', rel: 'noopener noreferrer' } : {});
---

<li class="game">
	<div class="game-top">
		<span class="game-n">{label}</span>
		{kind && <span class="game-kind">{kind}</span>}
	</div>
	<H class="game-title">
		<a href={href} {...out(external)}>{title}</a>
	</H>
	<p>{description}</p>
	{
		tags.length > 0 && (
			<ul class="game-tags">
				{tags.map((tag) => (
					<li>{tag}</li>
				))}
			</ul>
		)
	}
	{targets.length > 0 && <p class="game-targets">{targets.join(' · ')}</p>}
	{
		(meta || links.length > 0) && (
			<div class="game-foot">
				{meta && <span class="game-meta">{meta}</span>}
				{links.map((link) => (
					<a class="game-link" href={link.href} {...out(link.external)}>
						{link.label}
						{link.external ? ' ↗' : ' →'}
					</a>
				))}
			</div>
		)
	}
</li>

<style>
	.game {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 0;
		padding: 1.75rem 1.5rem;
		background-color: var(--bg);
		transition: background-color 0.2s;
	}
	.game:hover,
	.game:focus-within {
		background-color: var(--surface);
	}
	.game-top {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.8125rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.game-n {
		color: var(--accent);
	}
	.game-kind {
		color: var(--faint);
	}
	.game-title {
		margin: 0;
		font-size: 1.125rem;
		font-weight: 700;
		line-height: 1.3;
	}
	.game-title a {
		color: var(--text);
		text-decoration: none;
	}
	/* The title's link covers the whole cell; the other links sit above it. */
	.game-title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.game-title a:focus-visible {
		outline: none;
	}
	.game:has(.game-title a:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}
	.game p {
		margin: 0;
		color: var(--muted);
		font-size: 0.9375rem;
		line-height: 1.6;
	}
	.game-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.game-tags li {
		margin: 0;
		padding: 0.125rem 0.5rem;
		border: 1px solid var(--border-strong);
		color: var(--muted);
		font-size: 0.75rem;
	}
	.game p.game-targets {
		color: var(--faint);
		font-size: 0.8125rem;
	}
	.game-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1.25rem;
		margin-top: auto;
		padding-top: 0.5rem;
		font-size: 0.875rem;
	}
	.game-meta {
		margin-right: auto;
		color: var(--faint);
	}
	.game-link {
		position: relative;
		z-index: 1;
		color: var(--accent);
		text-decoration: none;
	}
	.game-link:hover {
		text-decoration: underline;
	}
</style>
