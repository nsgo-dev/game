---
// The home page, in the demoscene look of nsgo-website's game template: the package's demoscene pieces with the game layer's own words. Every fact here comes from the repository's README, docs and examples; the words are in src/home/words.ts, and those the site already had in every language in src/copy/ and src/content/showcase.ts.
import { ActionButton, Cards, Demo, Effect, Effects, End, Hero, Page, Parallax, SectionHead, Split, Ticker } from 'nsgo-website/components';
import { site } from 'nsgo-website/site';
import { copies } from '../copy.ts';
import GameCard from './GameCard.astro';
import GameGrid from './GameGrid.astro';
import { PLAYGROUND_IDS } from '../content/playground.ts';
import { SHOWCASE_ENTRIES } from '../content/showcase.ts';
import { words as allWords } from '../home/words.ts';
import { localePath } from '../lib/paths.ts';
import { repoFile } from '../lib/repo.ts';
import type { Lang } from '../locales.ts';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const s = site[lang];
const copy = copies[lang].home;
const words = allWords[lang];

const TARGETS = ['macOS', 'iOS', 'Windows', 'Linux', 'Android', 'Web'];
const DEMOS = ['tunnel', 'rotozoom', 'bounce', 'scope', 'trail', 'plasma'] as const;
const PACKAGE_ICONS = ['gamepad', 'trophy', 'network', 'cube', 'terminal', 'accessibility'];

// The packages docs/en/stability.md lists, each stable or experimental.
const stability = repoFile('docs/en/stability.md');
const packageCount = stability.split('\n').filter((line) => /^\| `[^`]+` \| (Stable|Experimental) \|/.test(line)).length;

const loop = repoFile('apps/website/snippets/loop.go.txt').trimEnd();
// A scene of the Field Medic example, as far as its first patient.
const scene = repoFile('examples/fieldmedic/scenes/ward.scene.yaml').split('\n').slice(0, 17).join('\n');

const examples = PLAYGROUND_IDS.map((id) => SHOWCASE_ENTRIES.find((e) => e.id === id)!);
const lead = `${copy.lead[0]}NSGo${copy.lead[1]}`;
const href = (path: string) => localePath(lang, path);
---

<Page lang={lang} title={s.title} description={s.description}>
	<Demo effect="stars" width={480} height={300} class="sky" />
	<div class="home">
		<Hero
			lang={lang}
			status={copy.badge}
			headline={words.headline}
			lead={lead}
			actions={[
				{ label: words.start, href: 'docs/getting-started/' },
				{ label: words.play, href: 'playground/', variant: 'secondary' },
				{ label: 'GitHub', href: s.repo, icon: 'github', variant: 'secondary' },
			]}
			chips={TARGETS}
		>
			<Demo slot="visual" effect="knot" width={280} height={280} drag class="knot" />
		</Hero>
		<Ticker items={words.ticker} />
		<Effects id="features" eyebrow={words.features.eyebrow} title={words.features.title}>
			{words.effects.map(([title, text], i) => <Effect demo={DEMOS[i]} title={title} text={text} />)}
		</Effects>
		<Split eyebrow={words.code.eyebrow} title={words.code.title} text={words.code.text} code={{ lang: 'go', code: loop }} />
		<Split
			id="formats"
			eyebrow={words.text.eyebrow}
			title={words.text.title}
			text={words.text.text}
			items={words.text.items.map(([title, text], i) => ({ icon: ['file-code', 'file-diff', 'files'][i], title, text }))}
			code={{ lang: 'yaml', code: scene }}
		/>
		<Cards
			id="packages"
			eyebrow={words.packages.eyebrow}
			title={words.packages.title.replace('{n}', String(packageCount))}
			text={words.packages.text}
			columns={3}
			items={words.packages.items.map(([title, text], i) => ({ icon: PACKAGE_ICONS[i], title, text }))}
		/>
		<section class="section" id="examples">
			<div class="container">
				<SectionHead eyebrow={words.examples.eyebrow} title={words.examples.title} text={words.examples.text} />
				<GameGrid>
					{
						examples.map((game, i) => (
							<GameCard
								label={String(i + 1).padStart(2, '0')}
								title={game.title[lang]}
								href={href(`playground/${game.id}/`)}
								description={game.description[lang]}
								tags={game.tags}
								links={[{ label: words.examples.source, href: game.sourceUrl, external: true }]}
							/>
						))
					}
				</GameGrid>
			</div>
		</section>
		<section class="section" id="stages">
			<div class="container">
				<SectionHead eyebrow={copy.stages.eyebrow} title={copy.stages.title} text={copy.stages.lead} />
				<ol class="stages">
					{
						copy.stages.names.map((name, i) => (
							<li class="stage">
								<span class="stage-n">{copy.stages.label(i + 1)}</span>
								<h3>{name}</h3>
								<p>{copy.stages.lines[i]}</p>
							</li>
						))
					}
				</ol>
				<p class="stages-more">
					<ActionButton lang={lang} index={1} action={{ label: copy.stages.more, href: 'roadmap/' }} />
				</p>
			</div>
		</section>
		<Parallax speed={-0.06} class="finale">
			<End
				lang={lang}
				logo="nsgo"
				title={words.end.title}
				text={words.end.text}
				actions={[
					{ label: words.end.site, href: lang === 'zh' ? 'https://nsgo.dev/zh/' : 'https://nsgo.dev' },
					{ label: 'GitHub', href: 'https://github.com/nsgo-dev/nsgo', icon: 'github' },
				]}
			/>
		</Parallax>
		<div class="ground" aria-hidden="true">
			<Demo effect="terrain" width={360} height={120} class="terrain" />
		</div>
	</div>
</Page>

<style>
	/* As the game template: stars behind the whole page, the knot reaching past the opening's right side, and terrain at the page's foot. */
	:global(.sky) {
		position: fixed;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		opacity: 0.4;
	}
	.home {
		overflow-x: clip;
	}
	@media (min-width: 64rem) {
		.home :global(.hero-row) {
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		}
	}
	:global(.knot) {
		width: 125%;
		max-width: none;
		height: auto;
		aspect-ratio: 1;
		margin: -12% -15% -12% -10%;
	}
	@media (max-width: 63.99rem) {
		:global(.knot) {
			width: 110%;
			margin: -8% -5%;
		}
	}
	:global(.shell) {
		position: relative;
	}
	.ground {
		position: absolute;
		inset: auto 0 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		-webkit-mask-image: linear-gradient(to bottom, #000 45%, rgb(0 0 0 / 0.22) 88%);
		mask-image: linear-gradient(to bottom, #000 45%, rgb(0 0 0 / 0.22) 88%);
	}
	:global(.terrain) {
		width: 100%;
		height: clamp(20rem, 40vw, 44rem);
		object-fit: cover;
	}
	.home :global(.end) {
		padding-bottom: clamp(6rem, 14vw, 12rem);
	}
	.home :global(.end-card) {
		background-color: var(--surface);
		box-shadow: 14px 14px 0 var(--drop);
	}

	/* The core's effects and the packages framed in the same grid of cells as the examples and the stages. */
	:root .home :global(#features .effects),
	:root .home :global(#packages .platforms) {
		gap: 1px;
		border: 1px solid var(--border);
		background-color: var(--border);
	}
	:root .home :global(#features .effects > li),
	:root .home :global(#packages .platform) {
		padding: 1.75rem 1.5rem;
		background-color: var(--bg);
	}
	:root .home :global(#packages .platform:hover) {
		background-color: var(--surface);
	}

	/* The stages, in the look's grid of cells. */
	.stages {
		display: grid;
		gap: 1px;
		margin: 0;
		padding: 0;
		border: 1px solid var(--border);
		background-color: var(--border);
		list-style: none;
	}
	@media (min-width: 40rem) {
		.stages {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 64rem) {
		.stages {
			grid-template-columns: repeat(5, minmax(0, 1fr));
		}
	}
	.stage {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 0;
		padding: 1.75rem 1.5rem;
		background-color: var(--bg);
	}
	.stage-n {
		color: var(--accent);
		font-size: 0.8125rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.stage h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
	}
	.stage p {
		margin: 0;
		color: var(--muted);
		font-size: 0.9375rem;
		line-height: 1.6;
	}
	/* Room under the stages for the closing card, which the parallax lifts toward them. */
	#stages {
		padding-bottom: clamp(7rem, 12vw, 11rem);
	}
	.stages-more {
		margin: 2rem 0 0;
		text-align: center;
	}
</style>
