---
// The head of one of the site's own pages: an eyebrow, the title and a few words, at the left as the docs have theirs.
interface Props {
	eyebrow?: string;
	title: string;
	text?: string;
}
const { eyebrow, title, text } = Astro.props;
---

<header class="page-head">
	{eyebrow && <p class="page-eyebrow">// {eyebrow}</p>}
	<h1>{title}</h1>
	{text && <p class="page-text">{text}</p>}
	<slot />
</header>

<style>
	.page-head {
		max-width: 46rem;
		margin: 0 0 2.5rem;
	}
	.page-eyebrow {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.8125rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		margin: 0;
		font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
		text-transform: uppercase;
	}
	.page-text {
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 1.0625rem;
		line-height: 1.65;
	}
</style>
