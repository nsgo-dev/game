---
// An example of the playground: its web build in a frame, loaded only when the reader runs it since its WebAssembly is megabytes, beside its source files, and how to run it on one's own machine. Nothing is compiled in the browser.
import { Code } from '@astrojs/starlight/components';
import 'nsgo-website/styles/home.css';
import { Page } from 'nsgo-website/components';
import PageHead from '../../../components/PageHead.astro';
import { PLAYGROUND_BUILDS, PLAYGROUND_IDS } from '../../../content/playground.ts';
import { copies } from '../../../copy.ts';
import { GITHUB_URL } from '../../../links.ts';
import { BASE, langPaths, localePath } from '../../../lib/paths.ts';
import { examples } from '../../../lib/playground.ts';
import type { Lang } from '../../../locales.ts';

export const getStaticPaths = () => langPaths().flatMap(({ params, props }) => PLAYGROUND_IDS.map((example) => ({ params: { ...params, example }, props: { ...props, example } })));
const { lang, example: id } = Astro.props as { lang: Lang; example: string };
const copy = copies[lang].playground;
const all = examples();
const example = all.find((e) => e.id === id)!;
const name = example.entry.title[lang];
const build = `${BASE}${PLAYGROUND_BUILDS}/${example.id}/`;
const megabytes = (example.wasm / 1_000_000).toFixed(1);
---

<Page lang={lang} title={`${name} — ${copy.heading}`} description={example.entry.description[lang]}>
	<div class="container own-page">
		<nav class="examples" aria-label={copy.examples}>
			<a href={localePath(lang, 'playground/')}>{copy.heading}</a>
			{
				all.map((other) => (
					<a href={localePath(lang, `playground/${other.id}/`)} aria-current={other.id === example.id ? 'page' : undefined}>
						{other.entry.title[lang]}
					</a>
				))
			}
		</nav>
		<PageHead title={name} text={example.entry.description[lang]} />
		<div class="body">
			<section class="stage" aria-label={name} data-stage data-src={build} data-title={copy.running(name)}>
				<div class="screen">
					{
						example.wasm > 0 ? (
							<div class="poster">
								<button type="button" class="button primary" data-run>
									▶ {copy.run}
								</button>
								<span class="size">{copy.download(megabytes)}</span>
							</div>
						) : (
							<div class="poster">
								<p>{copy.notBuilt}</p>
								<Code code={`bun run playground ${example.id}`} lang="sh" />
							</div>
						)
					}
				</div>
				<div class="bar">
					<span class="hint" data-hint hidden>{copy.focus}</span>
					<div class="actions">
						<button type="button" class="button secondary" data-restart hidden>{copy.restart}</button>
						{
							example.wasm > 0 && (
								<a class="button secondary" href={build} target="_blank" rel="noopener">
									{copy.newTab} ↗
								</a>
							)
						}
					</div>
				</div>
			</section>
			<section class="source" aria-label={copy.source}>
				<div class="tabs" role="tablist" aria-label={copy.source} data-tabs>
					{
						example.files.map((file, i) => (
							<button type="button" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-file={file.name}>
								{file.name}
							</button>
						))
					}
				</div>
				{
					example.files.map((file, i) => (
						<div class="panel" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i !== 0}>
							<Code code={file.code} lang={file.lang} />
							<p class="file">
								<span>{copy.lines(file.lines)}</span>
								<a href={`${GITHUB_URL}/blob/main/examples/${example.id}/${file.name}`} target="_blank" rel="noopener noreferrer">
									{copy.github} ↗
								</a>
							</p>
						</div>
					))
				}
			</section>
		</div>
		<section class="local" aria-labelledby="local-title">
			<h2 id="local-title">{copy.local.title}</h2>
			<p>{copy.local.body}</p>
			<Code code={`git clone ${GITHUB_URL}.git\ncd game/examples/${example.id}\ngo tool nsgo dev -target web`} lang="sh" />
		</section>
	</div>
</Page>

<script>
	// Run loads the game's frame; restart loads it again. A game reads the keyboard only while its frame has the focus.
	for (const stage of document.querySelectorAll<HTMLElement>('[data-stage]')) {
		const screen = stage.querySelector<HTMLElement>('.screen')!;
		const run = stage.querySelector<HTMLButtonElement>('[data-run]');
		const restart = stage.querySelector<HTMLButtonElement>('[data-restart]')!;
		const hint = stage.querySelector<HTMLElement>('[data-hint]')!;
		const start = () => {
			const frame = document.createElement('iframe');
			frame.src = stage.dataset.src!;
			frame.title = stage.dataset.title!;
			frame.allow = 'autoplay; fullscreen; gamepad';
			frame.addEventListener('load', () => {
				frame.focus();
				frame.contentWindow?.focus();
			});
			screen.replaceChildren(frame);
			restart.hidden = false;
			hint.hidden = false;
		};
		run?.addEventListener('click', start);
		restart.addEventListener('click', start);
	}

	// The source's tabs, a file each; the arrow keys move between them, and the address's fragment, such as #game.go, names the file shown, so a link can open the page on it.
	for (const list of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
		const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const select = (index: number, focus = false) => {
			tabs.forEach((tab, i) => {
				const on = i === index;
				tab.setAttribute('aria-selected', String(on));
				tab.tabIndex = on ? 0 : -1;
				document.getElementById(tab.getAttribute('aria-controls')!)!.hidden = !on;
			});
			if (focus) tabs[index]!.focus();
			history.replaceState(history.state, '', `#${encodeURIComponent(tabs[index]!.dataset.file!)}`);
		};
		tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i)));
		list.addEventListener('keydown', (event) => {
			const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
			if (!step) return;
			event.preventDefault();
			const current = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
			select((current + step + tabs.length) % tabs.length, true);
		});
		let name = location.hash.slice(1);
		try {
			name = decodeURIComponent(name);
		} catch {}
		const fromHash = tabs.findIndex((tab) => tab.dataset.file === name);
		if (fromHash > 0) select(fromHash);
	}
</script>

<style>
	.examples {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2.5rem;
	}
	.examples a {
		padding: 0.375rem 0.875rem;
		border: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.875rem;
		text-decoration: none;
		transition: border-color 0.2s, color 0.2s;
	}
	.examples a:hover {
		border-color: var(--border-strong);
		color: var(--text);
	}
	.examples a[aria-current='page'] {
		border-color: var(--accent);
		color: var(--accent);
	}
	.body {
		display: grid;
		gap: 1.5rem;
	}
	@media (min-width: 72rem) {
		.body {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
			align-items: start;
		}
	}
	.stage {
		border: 1px solid var(--border);
		background-color: var(--surface);
	}
	.screen {
		display: grid;
		aspect-ratio: 16 / 10;
		place-items: center;
		background-color: #000;
	}
	.screen :global(iframe) {
		width: 100%;
		height: 100%;
		border: 0;
	}
	.poster {
		display: grid;
		justify-items: center;
		gap: 1rem;
		max-width: 28rem;
		padding: 1.5rem;
		text-align: center;
	}
	.poster p {
		margin: 0;
		color: var(--muted);
	}
	.size {
		color: var(--faint);
		font-size: 0.875rem;
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		min-height: 3.5rem;
		padding: 0.625rem 0.75rem;
		border-top: 1px solid var(--border);
	}
	.bar [hidden] {
		display: none;
	}
	.hint {
		color: var(--faint);
		font-size: 0.875rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-left: auto;
	}
	.source {
		min-width: 0;
	}
	.tabs {
		display: flex;
		overflow-x: auto;
		border-bottom: 1px solid var(--border);
	}
	.tabs button {
		flex: none;
		padding: 0.625rem 1rem;
		border: 0;
		border-bottom: 2px solid transparent;
		background: none;
		color: var(--muted);
		font: inherit;
		font-size: 0.875rem;
		cursor: pointer;
	}
	.tabs button:hover {
		color: var(--text);
	}
	.tabs button[aria-selected='true'] {
		border-bottom-color: var(--accent);
		color: var(--accent);
	}
	.tabs button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}
	.panel {
		margin-top: 0.75rem;
	}
	.panel :global(pre) {
		max-height: 34rem;
	}
	.file {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin: 0.75rem 0 0;
		color: var(--faint);
		font-size: 0.875rem;
	}
	.file a {
		color: var(--accent);
		text-decoration: none;
	}
	.local {
		max-width: 46rem;
		margin-top: 4rem;
	}
	.local h2 {
		margin: 0;
		font-size: 1.5rem;
	}
	.local p {
		margin: 0.75rem 0 1.25rem;
		color: var(--muted);
	}
</style>
