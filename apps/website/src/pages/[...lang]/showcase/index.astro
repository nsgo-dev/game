---
// The showcase: games, examples and starters built on the game layer, from src/content/showcase.ts.
import 'nsgo-website/styles/home.css';
import { ActionButton, Page } from 'nsgo-website/components';
import GameCard from '../../../components/GameCard.astro';
import GameGrid from '../../../components/GameGrid.astro';
import PageHead from '../../../components/PageHead.astro';
import { isPlaygroundId } from '../../../content/playground.ts';
import { SHOWCASE_ENTRIES } from '../../../content/showcase.ts';
import { copies } from '../../../copy.ts';
import { CONTRIBUTING_URL, SHOWCASE_SUBMIT_URL } from '../../../links.ts';
import { langPaths, localePath } from '../../../lib/paths.ts';
import type { Lang } from '../../../locales.ts';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const copy = copies[lang].showcase;
---

<Page lang={lang} title={copy.heading} description={copy.description}>
	<div class="container own-page">
		<PageHead title={copy.heading} text={copy.intro} />
		<GameGrid label={copy.listLabel}>
			{
				SHOWCASE_ENTRIES.map((entry, i) => {
					const playground = isPlaygroundId(entry.id) ? localePath(lang, `playground/${entry.id}/`) : undefined;
					const play = playground ?? entry.playUrl;
					return (
						<GameCard
							level={2}
							label={copy.entry(i + 1)}
							kind={copy.kinds[entry.kind]}
							title={entry.title[lang]}
							href={play ?? entry.sourceUrl}
							external={!playground}
							description={entry.description[lang]}
							tags={entry.tags}
							targets={entry.targets}
							meta={`${copy.by} ${entry.author} · ${entry.license}`}
							links={[...(play ? [{ label: copy.play, href: play, external: !playground }] : []), { label: copy.source, href: entry.sourceUrl, external: true }]}
						/>
					);
				})
			}
		</GameGrid>
		<section class="submit" aria-labelledby="submit-title">
			<p class="submit-eyebrow">// {copy.submit.eyebrow}</p>
			<h2 id="submit-title">{copy.submit.title}</h2>
			<p>{copy.submit.body}</p>
			<div class="submit-actions">
				<ActionButton lang={lang} index={0} action={{ label: copy.submit.action, href: SHOWCASE_SUBMIT_URL }} />
				<ActionButton lang={lang} index={1} action={{ label: copy.submit.contributing, href: CONTRIBUTING_URL }} />
			</div>
		</section>
	</div>
</Page>

<style>
	.submit {
		margin-top: 4rem;
		padding: 2.5rem 2rem;
		border: 1px solid var(--border);
		background-color: var(--surface);
		box-shadow: 14px 14px 0 var(--drop);
	}
	.submit-eyebrow {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.8125rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.submit h2 {
		margin: 0;
		font-size: 1.5rem;
	}
	.submit p:not(.submit-eyebrow) {
		max-width: 40rem;
		margin: 0.75rem 0 0;
		color: var(--muted);
	}
	.submit-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
</style>
