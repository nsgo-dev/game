{
  "name": "game-monorepo",
  "private": true,
  "workspaces": [
    "website"
  ],
  "scripts": {
    "dev": "bun run --cwd website dev",
    "build": "bun run --cwd website build",
    "preview": "bun run --cwd website preview",
    "test": "bun run --cwd website test",
    "typecheck": "bun run --cwd website typecheck",
    "playground": "bun run --cwd website playground",
    "verify-agent-note-tree": "bun .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-tree.ts",
    "verify-agent-note-format": "bun .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-format.ts",
    "verify-archived": "bun .agents/skills/write-notes-like-deepseek/scripts/verify-archived-agent-notes.ts",
    "verify-notes": "bun .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-tree.ts && bun .agents/skills/write-notes-like-deepseek/scripts/verify-agent-note-format.ts && bun .agents/skills/write-notes-like-deepseek/scripts/verify-archived-agent-notes.ts",
    "archive-agent-note": "bun .agents/skills/write-notes-like-deepseek/scripts/archive-agent-note.ts",
    "check-anchors": "bun .agents/skills/write-notes-like-deepseek/scripts/check-note-anchors.ts",
    "init-board": "bun .agents/skills/write-notes-like-deepseek/scripts/build-board.ts --init board.html \"Engineering Decisions\"",
    "bundle-board": "bun .agents/skills/write-notes-like-deepseek/scripts/build-board.ts --bundle .agents/notes demo.html \"Engineering Decisions\""
  }
}
