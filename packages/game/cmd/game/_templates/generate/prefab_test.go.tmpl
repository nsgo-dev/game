package {{.Package}}

import (
	"os"
	"testing"

	"github.com/nsgo-dev/game/packages/game/entities"
	"github.com/nsgo-dev/game/packages/game/sceneformat"
)

func Test{{.Go}}Prefab(t *testing.T) {
	data, err := os.ReadFile("{{.Path}}")
	if err != nil {
		t.Fatal(err)
	}
	doc, err := sceneformat.ParseWith(data, sceneformat.ParseOptions{File: "{{.Path}}", Components: Components})
	if err != nil {
		t.Fatal(err)
	}
	w := entities.NewWorld()
	if e := {{.Go}}Prefab.Spawn(w); !w.Alive(e) {
		t.Fatal("{{.Go}}Prefab spawned no entity")
	}
	for _, l := range doc.Layers {
		sceneformat.WalkObjects(l.Objects, func(o, _ *sceneformat.ObjectDoc) bool {
			if _, ok := Prefabs[o.Prefab]; o.Prefab != "" && !ok {
				t.Errorf("{{.Path}}: object %s names prefab %q, which Prefabs does not register", o.ID, o.Prefab)
			}
			return true
		})
	}
}
