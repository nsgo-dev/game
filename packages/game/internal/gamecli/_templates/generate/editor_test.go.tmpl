//go:build gameeditor

package {{.Package}}

import (
	"testing"

	"github.com/nsgo-dev/game/packages/game/editor/editorcmd"
)

// TestEditorOpensTheProject opens the project in this directory in the game's editor, with its main scene when game.yaml names one, as go tool game editor does. Run it with go tool nsgo test . -tags gameeditor.
func TestEditorOpensTheProject(t *testing.T) {
	ed, err := editorcmd.New(editorOptions())
	if err != nil {
		t.Fatal(err)
	}
	if err := editorcmd.Open(ed, []string{"."}); err != nil {
		t.Fatal(err)
	}
	if ed.Project == nil {
		t.Fatal("the editor opened no project")
	}
	if missing := ed.MissingPlugins(); len(missing) > 0 {
		t.Errorf("game.yaml turns on editor plugins the editor is built without: %v", missing)
	}
	if ed.BuildErr != nil {
		t.Errorf("the open scene does not build: %v", ed.BuildErr)
	}
}
